# AlgoLiquid Studio — environment variables
#
# Copy the relevant section into your hosting provider's settings (or into a
# local, git-ignored .env file). Nothing here is a secret: the app has no
# authentication, database or payments yet.
#
# Two independently deployed components:
#   1. web editor  (apps/editor, Next.js)        -> https://studio.algoliquid.com
#   2. render API  (services/render-api, FastAPI + tradeanim + FFmpeg)
#                                                 -> e.g. https://api.studio.algoliquid.com

# --------------------------------------------------------------------------
# 1) Web editor (Next.js). NEXT_PUBLIC_* are inlined at BUILD time.
#    Defaults live in apps/editor/.env.development and apps/editor/.env.production;
#    variables set in the build environment override them.
# --------------------------------------------------------------------------

# Public URL of the render API, no trailing slash.
#   development: http://localhost:8000
#   production : https://api.studio.algoliquid.com
#   empty      : call /api on the editor's own origin (reverse-proxy setups)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Canonical URL of the editor (metadata, Open Graph).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Port for `next start` (production server). Default 3000.
PORT=3000

# Set to "standalone" to emit a self-contained server (used by apps/editor/Dockerfile).
# NEXT_OUTPUT=standalone

# --------------------------------------------------------------------------
# 2) Render API (FastAPI). Read by services/render-api/settings.py.
# --------------------------------------------------------------------------

# development | production. Production switches on the secure defaults below.
APP_ENV=development

# Comma-separated browser origins allowed by CORS (exact match, no trailing slash).
#   development default: http://localhost:3000,http://127.0.0.1:3000
#   production  default: https://studio.algoliquid.com
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Bind address / port for the production start command (start.sh / npm run start:api).
HOST=0.0.0.0
# PORT=8000

# Trust X-Forwarded-* headers from these proxy IPs ("*" behind a managed load balancer).
FORWARDED_ALLOW_IPS=*

# Where render jobs (and dev project files) are written. Mount persistent or
# ephemeral disk here; renders are deleted after RENDER_RETENTION_HOURS.
WORKSPACE_DIR=./workspace

# Server-side project storage (GET/PUT /api/projects). There is no auth yet, so it
# defaults to OFF in production; the editor then saves projects in the browser.
# PROJECT_STORAGE_ENABLED=false

# Render limits (production defaults shown).
# MAX_RENDER_SECONDS=120
# MAX_RENDER_PIXELS=3686400
# MAX_RENDER_FPS=60
# MAX_QUEUED_RENDERS=20
# MAX_REQUEST_MB=40
# RENDER_RETENTION_HOURS=24

# Interactive OpenAPI docs at /api/docs (default: on in development, off in production).
# API_DOCS_ENABLED=false

# debug | info | warning | error
LOG_LEVEL=info

# Optional explicit FFmpeg binary. Default: ffmpeg on PATH, then the bundled imageio-ffmpeg.
# TRADEANIM_FFMPEG=/usr/bin/ffmpeg
